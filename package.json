{
  "name": "react-native-safe-area-context",
  "version": "5.9.1",
  "description": "A flexible way to handle safe area, also works on Android and web.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-safe-area-context-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./jest/mock": {
      "react-native-safe-area-context-source": "./src/jest/mock.tsx",
      "types": "./lib/typescript/src/jest/mock.d.ts",
      "default": "./lib/module/jest/mock.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "common",
    "*.podspec",
    "react-native.config.js",
    "!lib/commonjs",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!example"
  ],
  "author": "Janic Duplessis <janicduplessis@gmail.com>",
  "contributors": [
    "Evan Bacon <bacon@expo.io> (https://github.com/evanbacon)"
  ],
  "homepage": "https://github.com/AppAndFlow/react-native-safe-area-context#readme",
  "bugs": {
    "url": "https://github.com/AppAndFlow/react-native-safe-area-context/issues"
  },
  "license": "MIT",
  "scripts": {
    "start": "react-native start",
    "test": "yarn format:check && yarn validate:oxlint && yarn validate:typescript && yarn validate:jest",
    "validate:oxlint": "oxlint src example",
    "validate:typescript": "tsc --project ./ --noEmit",
    "validate:jest": "jest",
    "format:oxfmt:check": "oxfmt \"src/**/*.{js,ts,tsx}\" \"example/**/*.{js,ts,tsx}\" --check",
    "format:oxfmt:write": "oxfmt \"src/**/*.{js,ts,tsx}\" \"example/**/*.{js,ts,tsx}\" --write",
    "format:clang:check": "clang-format --dry-run --Werror --glob='{ios,android/src,common}/**/*.{h,cpp,m,mm}'",
    "format:clang:write": "clang-format -i --glob='{ios,android/src,common}/**/*.{h,hpp,cpp,m,mm}'",
    "format:spotless:check": "cd android && ./gradlew spotlessCheck",
    "format:spotless:write": "cd android && ./gradlew spotlessApply",
    "format:check": "yarn format:oxfmt:check && yarn format:clang:check && yarn format:spotless:check",
    "format:write": "yarn format:oxfmt:write && yarn format:clang:write && yarn format:spotless:write",
    "release": "release-it",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "react native",
    "react-native-web",
    "expo-web",
    "safe area",
    "view"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.82.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.2.2",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "^0.87.0",
    "@react-native/eslint-plugin": "^0.87.0",
    "@react-native/eslint-plugin-specs": "^0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@release-it/conventional-changelog": "^8.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.0",
    "@types/react-dom": "^19.2.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "clang-format": "^1.8.0",
    "commitlint": "^19.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.0.11",
    "jest": "^29.2.1",
    "jest-environment-jsdom": "^29.7.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "^0.87.0",
    "react-native-builder-bob": "^0.43.0",
    "react-test-renderer": "19.2.8",
    "release-it": "^17.4.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AppAndFlow/react-native-safe-area-context.git"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironment": "node",
    "clearMocks": true,
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "android": {
      "javaPackageName": "com.th3rdwave.safeareacontext"
    },
    "ios": {
      "componentProvider": {
        "RNCSafeAreaProvider": "RNCSafeAreaProviderComponentView",
        "RNCSafeAreaView": "RNCSafeAreaViewComponentView"
      }
    },
    "name": "safeareacontext",
    "type": "all",
    "jsSrcsDir": "./src/specs"
  },
  "packageManager": "yarn@1.22.22"
}
